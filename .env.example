# Optional. Proofline never stores these; it reads them from the environment only.
# Prefer `kane-cli login` (OAuth profile) and leave these unset.
# KANE_USERNAME=
# KANE_ACCESS_KEY=
# Where the run store lives (default: ./runs)
# PROOFLINE_HOME=
# Folder kane-cli runs in: its context store and *_test.md files (default: $PROOFLINE_HOME/workspace)
# PROOFLINE_WORKDIR=
